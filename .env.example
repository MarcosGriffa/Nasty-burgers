# Supabase — sin esto la app arranca en modo demo
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Asistente de precios (opcional)
# En producción la key va SOLO en el servidor (Vercel/Netlify → GEMINI_API_KEY)
# y el navegador pega contra /api/asistente. Esta variable es para probar
# en tu máquina: si la ponés, la key queda visible en el bundle.
VITE_GEMINI_API_KEY=
# Si la función serverless está en otra URL:
VITE_ASISTENTE_URL=
